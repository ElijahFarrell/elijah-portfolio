# Copy to .env.local for local work. On Vercel, set these in the project settings.
# Variables added by Marketplace integrations (Neon, Upstash) fill in automatically.

# Postgres (Neon, via the Vercel Marketplace). Stores chat questions for 90 days.
DATABASE_URL=

# Vercel sends this as a bearer token to the cleanup cron. Any long random string.
CRON_SECRET=

# How many days to keep chat questions before the daily cleanup deletes them.
RETENTION_DAYS=90
