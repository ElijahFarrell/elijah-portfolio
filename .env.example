# Copy to .env.local for local work. On Vercel, set these in the project settings.
# Variables added by Marketplace integrations (Neon, Upstash) fill in automatically.

# Postgres (Neon, via the Vercel Marketplace). Stores chat questions for 90 days.
DATABASE_URL=

# Vercel sends this as a bearer token to the cleanup cron. Any long random string.
CRON_SECRET=

# How many days to keep chat questions before the daily cleanup deletes them.
RETENTION_DAYS=90

# --- Chat ---
# Master switch. The panel stays hidden and /api/chat refuses until this is "true".
CHAT_ENABLED=false
# AI Gateway auth. On Vercel deployments the gateway can use the project's OIDC token
# automatically; set a key only for local runs or if OIDC isn't available.
AI_GATEWAY_API_KEY=
# Any AI Gateway model ID. Switch to openai/gpt-6-luna to compare.
CHAT_MODEL=anthropic/claude-haiku-5.5
CHAT_MAX_INPUT_CHARS=4000
CHAT_MAX_OUTPUT_TOKENS=400
# Earlier question/answer pairs (from the database) sent with each new question.
CHAT_HISTORY_TURNS=6

# Retrieval over content_chunks (Substack, advice). Leave off until the table is filled.
RAG_ENABLED=false
EMBEDDING_MODEL=openai/text-embedding-3-small
RAG_TOP_K=4

# --- Limits ---
# Upstash Redis (Vercel Marketplace sets KV_REST_API_URL/TOKEN). Required: without it the
# chat refuses to run, since it's what enforces the limits below.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Questions per visitor (hashed IP) per sliding window.
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_SECONDS=600
# Questions per chat session before "Clear chat" is needed.
SESSION_MAX_TURNS=20
# Daily spend cutoff in USD (UTC day). Also set a budget on the AI Gateway key as a backstop.
DAILY_BUDGET_USD=3
# Required. Any long random string (openssl rand -hex 32); visitor IPs are hashed
# with it before use. Without it the chat refuses to run.
IP_HASH_SALT=
# Cloudflare Turnstile. With the secret set, each new chat session must pass a check,
# and TURNSTILE_VERIFY_URL must be set to Turnstile's server-side siteverify URL
# (see Cloudflare's Turnstile docs).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_VERIFY_URL=
