{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/:section(en|about|work|services|blog|gallery)/:rest*",
      "destination": "/",
      "permanent": false
    }
  ],
  "crons": [
    {
      "path": "/api/cron/cleanup",
      "schedule": "0 6 * * *"
    }
  ],
  "functions": {
    "api/chat.ts": {
      "includeFiles": "{public/llms.txt,content/notes.md}",
      "maxDuration": 30
    }
  }
}
